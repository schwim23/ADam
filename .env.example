# --- GAM mode (set GAM_NETWORK_CODE to enable) ---
# Get your network code from GAM Admin > Global settings
GAM_NETWORK_CODE=123456789

# Auth — choose one:
#
# Option A (recommended): Application Default Credentials — no key file needed.
#   Run once: gcloud auth application-default login \
#     --scopes=https://www.googleapis.com/auth/dfp,https://www.googleapis.com/auth/cloud-platform
#   Then add prometheusagent23@gmail.com (or your service account email) to:
#   GAM Admin → Global settings → API access
#
# Option B: Explicit service account JSON key (if ADC is not available)
#   GAM_CREDENTIALS_JSON={"type":"service_account","client_email":"...","private_key":"..."}

# --- AdCP mode (used if GAM_NETWORK_CODE is not set) ---
ADCP_BASE_URL=https://your-adcp-server.example.com
ADCP_API_KEY=your_api_key_here

# Anthropic (for web + CLI clients)
ANTHROPIC_API_KEY=your_anthropic_key_here

# Web API auth — set this to require a Bearer token on /api/chat
# If unset, the route is open (fine for local dev, not for production)
ADAM_WEB_API_KEY=your_secret_key_here

# Web only — path to the compiled MCP server (default works for monorepo dev)
# ADAM_MCP_PATH=../mcp-server/dist/index.js
